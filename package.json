{
  "name": "sales-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development nodemon --exec ts-node -r dotenv/config --project tsconfig.server.json src/server/index.ts | pino-pretty -i hostname,pid,req,res,id,responseTime,startDate -t",
    "build": "next build src/client && tsc --project tsconfig.server.json",
    "build-server": "tsc --project tsconfig.server.json",
    "start": "NODE_ENV=production node -r dotenv/config dist/src/server/index.js | pino-pretty -i hostname,pid,req,res,id,responseTime,startDate -t",
    "test": "jest --config ./jest.config.js",
    "types": "graphql-codegen --config codegen.yml",
    "prepare": "husky"
  },
